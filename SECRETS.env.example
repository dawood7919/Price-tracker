# ============================================================
# SECRETS.env.example — قالب بيانات التشغيل
# ============================================================
# الاستخدام:
#   1) انسخ الملف على السيرفر فقط:
#        cp SECRETS.env.example SECRETS.env
#        # أو ادمجه في .env
#   2) املأ القيم الحقيقية على السيرفر
#   3) لا ترفع SECRETS.env أو .env إلى GitHub أبدًا
#
# الملف الحقيقي على السيرفر:  .env   أو   SECRETS.env
# (مذكور في .gitignore)
# ============================================================

# ---------- تيليجرام (مطلوب) ----------
TELEGRAM_BOT_TOKEN=
# من @BotFather → /token

TELEGRAM_OWNER_ID=1096429310
# آيدي المالك الرقمي (من @userinfobot)

# ---------- Local Bot API (اختياري — رفع ملفات لحد ~2GB) ----------
# من https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# لو بتشغّل Bot API بنفسك بدون start.sh:
# TELEGRAM_BASE_URL=http://127.0.0.1:8081

# ---------- Webhook (اختياري — Render/Railway) ----------
# WEBHOOK_URL=https://your-domain.example
# PORT=8080

# ---------- yt-dlp cookies (اختياري) ----------
# YTDLP_COOKIES_FILE=/app/cookies.txt
# YTDLP_COOKIES_CONTENT=

# ---------- /secret — wow.xxx ----------
SECRET_BASE_URL=https://www.wow.xxx/
SECRET_PAGE_SIZE=15
SECRET_MAX_RESULTS=60

# ---------- حدود عامة ----------
MAX_CONCURRENT_DOWNLOADS=20
MAX_PLAYLIST_ITEMS=10
MIN_FREE_DISK_MB=500
DOWNLOAD_TIMEOUT_SECONDS=1800

# ---------- GitHub (للسيرفر فقط — git pull لمستودع خاص) ----------
# لا تضع التوكن في الكود. استخدمه مؤقتًا في الأمر ثم امسحه:
#   export GH_TOKEN=ghp_xxxx
#   git remote set-url origin https://$GH_TOKEN@github.com/dawood7919/learning-programming-app.git
#   git pull
#   git remote set-url origin https://github.com/dawood7919/learning-programming-app.git
# GH_TOKEN=
# صلاحية مطلوبة: repo
#
# ⚠️ أي توكن اتنشر في شات → Revoke فورًا من GitHub Settings

# ---------- AI (ملغى — لا حاجة له) ----------
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
# AI_CHAT_MODE=
