# === مطلوب ===
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-botfather

# === اختياري ===
# لو مفيش WEBHOOK_URL ولا RENDER_EXTERNAL_URL ولا RAILWAY_PUBLIC_DOMAIN
# البوت يشتغل polling (مناسب محليًا). على Render/Railway بيتظبط تلقائيًا.
# WEBHOOK_URL=https://myapp.onrender.com

# Local Bot API Server — يرفع حد الرفع من 49MB لـ 2GB
# يتظبط تلقائيًا من start.sh لو حطيت الاتنين دول (من https://my.telegram.org)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# لو بتشغّل سيرفر Bot API خارجي بنفسك بدل start.sh، حط رابطه هنا بدل الاتنين اللي فوق
# TELEGRAM_BASE_URL=http://localhost:8081

# كوكيز لـ yt-dlp (مواقع بتطلب تسجيل دخول، أو تغريدات حساسة/محمية على X)
# محليًا: حط مسار الملف
# YTDLP_COOKIES_FILE=/app/cookies.txt
# على Render (طريقة 1 — env var): حط محتوى الملف نفسه هنا كمتغير سري (sync: false)
# وهيتكتب تلقائيًا لملف عند تشغيل البوت.
# YTDLP_COOKIES_CONTENT=
# على Render (طريقة 2 — أسهل، عبر تيليجرام): حط رقم الآيدي بتاعك في
# TELEGRAM_OWNER_ID وابعت /setcookies للبوت من حسابك، وابعتله ملف cookies.txt
# أو الصق محتواه كرسالة نصية. من غير الآيدي ده الأمر متعطّل تمامًا لأي حد.
# TELEGRAM_OWNER_ID=
#
# في الحالتين: صدّر الكوكيز بنفسك من متصفحك وانت مسجل دخول (بإكستنشن تصدير
# كوكيز عادي) — البوت من غير ما يشوف باسورد أو يعمل أي صفحة تسجيل دخول
# بتاعته، انت بس بتوديله الملف اللي صدرته بنفسك.

# حدود (مفيش حد يومي أو حد لكل مستخدم — أي مستخدم يقدر يشغّل أكتر من تحميل بالتوازي)
# MAX_CONCURRENT_DOWNLOADS=20
# MAX_PLAYLIST_ITEMS=10
# MIN_FREE_DISK_MB=500
# DOWNLOAD_TIMEOUT_SECONDS=1800
# SAFE_UPLOAD_LIMIT=51380224
